# Supabase — get these from your Supabase project settings
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Stripe — Checkout session URL (pre-built checkout link or your custom endpoint)
VITE_STRIPE_CHECKOUT_URL=https://buy.stripe.com/your-link
VITE_STRIPE_LIFECHANGER_CHECKOUT_URL=https://buy.stripe.com/your-lifechanger-link
STRIPE_LIFECHANGER_PRICE_ID=price_your_lifechanger_price

# Stripe Customer Portal URL (Stripe Dashboard → Customer Portal → Settings → Portal link)
VITE_STRIPE_PORTAL_URL=https://billing.stripe.com/p/login/your-portal-link

# Web Push VAPID — generate with: npx web-push generate-vapid-keys
VITE_VAPID_PUBLIC_KEY=your-vapid-public-key

# Sentry — error tracking (optional, leave blank for local dev)
VITE_SENTRY_DSN=
